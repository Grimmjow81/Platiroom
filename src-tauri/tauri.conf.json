{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Platiroom",
  "identifier": "com.platiroom.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Platiroom v1.0.0",
        "width": 1700,
        "height": 900,
        "minWidth": 1700,
        "minHeight": 900,
		"maximized": true,
		"center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}